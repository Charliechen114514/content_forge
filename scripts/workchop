#!/usr/bin/env python3
"""content-forge 统一入口(纯文字加工平台 dispatcher)。

用法:
  workchop bake [lane] [--check] 烘焙角色包(--check 只对账不写文件)
  workchop doctor                环境体检
  workchop review ...            建立/记录/检查稿件复审验收
  workchop cc-backup             轻量备份 Claude Code 状态(换机用)

发版业务(今日视图、待办聚合、源软链)在 ~/waver 的 scripts/waver。
"""
import sys, subprocess
from pathlib import Path

S = Path(__file__).resolve().parent
PY = sys.executable

DISPATCH = {
    "doctor":            [PY, str(S / "doctor.py")],
    "cc-backup":         [PY, str(S / "backup_claude_code.py")],
    "review":            [PY, str(S / "review_gate.py")],
    "bake":              [PY, str(S.parent / "tools/bake.py")],
}


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "doctor"
    if cmd in ("-h", "--help"):
        print(__doc__); return
    if cmd not in DISPATCH:
        print(f"✗ 未知命令 {cmd}\n\n{__doc__}"); sys.exit(1)
    sys.exit(subprocess.run(DISPATCH[cmd] + sys.argv[2:]).returncode)


if __name__ == "__main__":
    main()
